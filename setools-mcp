#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only

from setools.mcp import MCPConfig, SEToolsMCPServer
import argparse
import logging
import sys
import warnings

parser = argparse.ArgumentParser(
    description="SETools MCP server — exposes setools policy analysis as MCP tools.")
parser.add_argument("config", metavar="CONFIG", nargs="?",
                    help="MCP server configuration file, providing the bind address and the "
                         "authentication settings.  The HTTP transport is used when this is "
                         "provided, otherwise stdio is used.")
parser.add_argument("--policy", metavar="PATH", help="Default SELinux policy file to analyze.")
parser.add_argument("-v", "--verbose", action="store_true",
                    help="Print extra informational messages")
parser.add_argument("--debug", action="store_true", dest="debug", help="Enable debugging.")
args = parser.parse_args()

if args.debug:
    logging.basicConfig(level=logging.DEBUG,
                        format='%(asctime)s|%(levelname)s|%(name)s|%(message)s')
    if not sys.warnoptions:
        warnings.simplefilter("default")
elif args.verbose:
    logging.basicConfig(level=logging.INFO, format='%(message)s')
    if not sys.warnoptions:
        warnings.simplefilter("default")
else:
    logging.basicConfig(level=logging.WARNING, format='%(message)s')
    if not sys.warnoptions:
        warnings.simplefilter("ignore")

try:
    if args.config:
        config = MCPConfig(args.config)
        server = SEToolsMCPServer(default_policy=args.policy, auth=config.auth_provider)
        assert config.bind_address, "Bind address unset, this is a bug."
        assert config.bind_port, "Bind port unset, this is a bug."
        server.run(transport="http", host=config.bind_address, port=config.bind_port)
    else:
        server = SEToolsMCPServer(default_policy=args.policy, auth=None)
        server.run(transport="stdio")

except AssertionError:
    # Always provide a traceback for assertion errors
    raise

except Exception as err:
    print(err)
    sys.exit(1)
